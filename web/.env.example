# Built-in demo data is the default. Point the panel at a backend by setting this, and it
# answers every screen from that origin plus `/api/v1` instead — no code change.
# VITE_API_BASE_URL=https://where-the-backend-answers

# The name the panel prints in the sidebar, on the sign-in card and in the browser tab.
# VITE_APP_NAME=Demo Operations Panel
